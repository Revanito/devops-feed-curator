# 1min.ai API key (same one used by discord-1min-proxy)
ONE_MIN_API_KEY=

# Cheap model for classification - see MODELS.md in discord-1min-proxy for the full list
MODEL_CLASSIFIER=gpt-4o-mini

# How often to poll all feeds, in minutes
POLL_INTERVAL_MINUTES=30

# Optional: set a random secret to enable POST /refresh for manual forced polls
# (curl -X POST -H "X-Admin-Token: <value>" https://feeds.vaultinc.fr/refresh).
# Leave blank on a public deployment to disable that endpoint entirely.
ADMIN_TOKEN=
