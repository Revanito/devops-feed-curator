# 1min.ai API key (https://1min.ai)
ONE_MIN_API_KEY=

# Cheap model for classification - any model name supported by 1min.ai's API works
MODEL_CLASSIFIER=gpt-4o-mini
# Fallback if the primary is down/retired - pick a different provider so one outage can't take out both.
# Leave blank to disable.
MODEL_CLASSIFIER_FALLBACK=us.anthropic.claude-haiku-5-5

# Security feeds, CISA KEV and NVD are polled every this many minutes. Only new items are sent to
# the LLM, so a shorter interval costs little extra.
NEWS_POLL_MINUTES=60

# The eBay deals poll runs once a day at this hour:minute (server local time). Use the "Refresh now"
# button (or POST /refresh with an admin token) to poll everything on demand between scheduled runs.
POLL_HOUR=0
POLL_MINUTE=0

# Optional free NVD API key (https://nvd.nist.gov/developers/request-an-api-key) - raises NVD's rate
# limit so big fetches are faster. Works without it.
NVD_API_KEY=

# CVEs published longer ago than this are ignored even if NVD scores them now. Vulnerability rows
# are kept this long so an old one can't come back as "new".
ADVISORY_MAX_AGE_DAYS=30

# Reddit gets its own, much longer clock instead of the regular poll above - its anonymous RSS
# access blocks any request that follows another too soon (a single combined multireddit request
# works, a second one seconds later doesn't). Fetched at most once every this many hours,
# independent of the poll schedule and of manual refreshes, so neither burns down its budget. Tune
# up if 429s/blocks come back, down if it turns out too conservative.
REDDIT_POLL_HOURS=8

# The Security page shows what was flagged in the last this-many days. News items older than this
# (based on when this app first saw them) get deleted each poll.
NEWS_MAX_AGE_DAYS=7

# Minimum minutes between manual refreshes triggered from the public "Refresh now"
# button, so a shared link can't be used to spam paid LLM classification calls.
REFRESH_COOLDOWN_MINUTES=10

# Optional secret. Needed to hide items on the Security page: open /login once and enter it (the
# browser stays logged in for a year). Also bypasses the refresh cooldown above
# (curl -X POST -H "X-Admin-Token: <value>" https://feeds.example.com/refresh).
# Leave blank and nobody can hide anything.
ADMIN_TOKEN=

# eBay Browse API credentials (developer.ebay.com -> create an app -> production keys) for the
# Homelab Deals column. Leave both blank to disable that column entirely - nothing else breaks.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Comma-separated eBay marketplace IDs to search. EBAY_GB listings are cross-border (post-Brexit) -
# flagged on the card as possibly incurring import VAT/duty, since eBay's API can't reliably quote
# that ahead of checkout.
EBAY_MARKETPLACES=EBAY_FR,EBAY_DE,EBAY_GB

# ISO country code passed to eBay's search filter so only listings that can actually be delivered
# here show up - no point surfacing a UK listing with no shipping to France, for example.
EBAY_DELIVERY_COUNTRY=FR

# Price ceiling in EUR, applied to item price + shipping combined (GBP listings are converted to
# EUR first using GBP_TO_EUR_RATE below). This is the boundary for the main Homelab Deals page.
DEAL_MAX_PRICE_EUR=500

# Ceiling for the separate "<price>€ and beyond" page - listings priced between
# DEAL_MAX_PRICE_EUR and this show up there instead, for a looser budget. Keeps totally
# unrelated high-end/enterprise gear out.
DEAL_EXTENDED_MAX_PRICE_EUR=1500

# Price ceilings for the separate RAM Deals pages, in EUR (same price+shipping/GBP-conversion rules
# as the Homelab Deals ceilings above). RAM has its own, much lower ceilings - a stick or kit rarely
# costs anywhere near what a whole mini PC does.
RAM_MAX_PRICE_EUR=200
RAM_EXTENDED_MAX_PRICE_EUR=500

# GBP->EUR rate for EBAY_GB listings. The live ECB rate is fetched each poll (frankfurter.dev);
# this value is only the fallback if that fetch fails.
GBP_TO_EUR_RATE=1.17

# How many already-kept deal listings to re-check against eBay per poll, to remove ones that have
# sold or been taken down since we last saw them. A rolling sweep, not everything every time, so
# the per-poll cost stays flat regardless of how many listings have piled up.
DEAL_RECHECK_BATCH_SIZE=50
